# Copy to .env.local for dev, .env for Compose. Never commit real values.
DATABASE_URL=postgresql://hnb:CHANGE_ME@127.0.0.1:5432/hanngubien
# Generate using: openssl rand -base64 48
SESSION_PASSWORD=
SESSION_TTL_SECONDS=43200
# true for production HTTPS; false only on an isolated HTTP demo.
SESSION_SECURE=true
APP_ORIGIN=https://hanngubien.internal
MEDIA_DIR=./work/media
NEXT_TELEMETRY_DISABLED=1
TZ=Asia/Bangkok
# Compose-only settings. Database port is never published.
POSTGRES_USER=hnb
POSTGRES_DB=hanngubien
POSTGRES_PASSWORD=
LAN_HOST=127.0.0.1
LAN_PORT=3000
